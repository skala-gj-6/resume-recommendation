POSTGRES_DB=resume_service
POSTGRES_USER=resume_user
POSTGRES_PASSWORD=resume_password
POSTGRES_PORT=5432

MOCK_API_PORT=8000
MOCK_API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

BACKEND_PORT=8080
FRONTEND_PORT=5173

# MVP에서는 JPA가 엔티티를 기준으로 스키마를 갱신합니다.
# 운영 환경에서는 Flyway/Liquibase와 validate 조합으로 교체합니다.
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# 기본값 mock은 외부 AI를 호출하지 않습니다.
# OpenAI 호환 Chat Completions 서버를 사용할 때 llm으로 변경합니다.
AI_MODE=mock
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_CHAT_COMPLETIONS_PATH=/chat/completions
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_CONNECT_TIMEOUT=3s
LLM_READ_TIMEOUT=45s
LLM_MAX_ATTEMPTS=2
LLM_DEFAULT_TARGET_CHARS=700
