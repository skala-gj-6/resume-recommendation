POSTGRES_DB=resume_service
POSTGRES_USER=resume_user
POSTGRES_PASSWORD=resume_password
POSTGRES_PORT=5432

MOCK_API_PORT=8000
MOCK_API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

BACKEND_PORT=8080
FRONTEND_PORT=5173

# MVP에서는 JPA가 엔티티를 기준으로 스키마를 갱신합니다.
# 운영 환경에서는 Flyway/Liquibase와 validate 조합으로 교체합니다.
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# 경험 구조화와 초안 생성은 항상 OpenAI를 호출합니다.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=45s
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8000
LLM_MAX_ATTEMPTS=2
LLM_DEFAULT_TARGET_CHARS=700
LLM_TARGET_RATIO=0.9
LLM_MINIMUM_RATIO=0.7
LLM_EXPERIENCE_PROMPT_LOCATION=classpath:prompts/experience-structure.st
LLM_COVER_LETTER_PROMPT_LOCATION=classpath:prompts/cover-letter-generation.st
LLM_EXPERIENCE_SCHEMA_LOCATION=classpath:schemas/experience-structure.json
LLM_COVER_LETTER_SCHEMA_LOCATION=classpath:schemas/cover-letter-generation.json
DRAFT_PENDING_STALE_AFTER=30m
DRAFT_GENERATING_STALE_AFTER=3m
DRAFT_RECOVERY_SCAN_INTERVAL=1m

# 시작 시 경험, 공고 스냅샷, 문항만 준비합니다. 초안과 수정본은 생성하지 않습니다.
DEMO_DATA_ENABLED=true
